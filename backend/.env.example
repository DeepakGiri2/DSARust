# Local development settings for `cargo run -p dsa-api`.
# Copy to backend/.env (git-ignored) and adjust. Every variable is documented
# in docs/platform/SERVICES.md; production values come from ECS + Secrets
# Manager, never from a file.

DSA_ENV=development
DSA_BIND=127.0.0.1:8080
DSA_METRICS_BIND=127.0.0.1:9464
DSA_PUBLIC_URL=http://localhost:5173
DSA_CONTENT_DIR=../content

# `docker compose up postgres redis` from the repo root, or any Postgres 16+.
DATABASE_URL=postgres://dsa:dsa@127.0.0.1:55432/dsa
REDIS_URL=redis://127.0.0.1:56379
RUN_MIGRATIONS=true

# http = the sandboxed runner from docker-compose (`docker compose up runner`).
# local = this machine's toolchains with NO sandbox — development only.
RUNNER_MODE=local

# Emails are printed to the log; links in them work.
MAIL_MODE=log

# none | ollama (a local server, like the desktop) | anthropic | bedrock
AI_PROVIDER=none
# OLLAMA_URL=http://localhost:11434
# AI_MODEL=gemma3:4b

# Accounts that become admin once their email is verified.
# ADMIN_EMAILS=you@example.com

LOG_FORMAT=pretty
RUST_LOG=info,dsa_api=debug,tower_http=info

# Local test account used when walking through the app by hand and by the
# compose end-to-end check. Local development databases only: it is an
# ordinary sign-up (POST /api/v1/auth/signup) — create it again in a fresh
# database, and never in a shared or production one.
#   email:    demo@dsa.test
#   password: violet-harbor-lantern-42
#   name:     Demo Learner

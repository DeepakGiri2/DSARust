// Subsets II — skip a repeat only when it is a sibling.
//
// Sorting puts equal values next to each other. The condition `i > start`
// matters more than it looks: at the *first* position of a loop a repeated
// value is the first copy and must be taken, but later in the same loop it
// would produce a subset already generated by its twin.

fn back(nums, start, cur, found) {
    enter(`back(start=${start})`, #{ current: A(cur) });

    found.push(brackets(cur));
    log(`subset ${brackets(cur)}`, "result");
    step("record", `Every node of the search is itself a subset — record ${brackets(cur)}.`,
        [ array("nums (sorted)", nums).ptr("start", start).done(before(start)),
          array("current", cur) ]);

    for i in start..nums.len() {
        step("loop", `Consider taking nums[${i}] = ${nums[i]}.`,
            [ array("nums (sorted)", nums).pointers(#{ start: start, i: i }).hl([i]),
              array("current", cur) ]);

        if i > start && nums[i] == nums[i - 1] {
            step("dup",
                `nums[${i}] repeats nums[${i - 1}], and this is not the first slot of the loop — its twin already generated every subset starting this way.`,
                [ array("nums (sorted)", nums).pointers(#{ start: start, i: i }).bad([i]) ]);
            step("skip", "Skip it to avoid a duplicate subset.",
                [ array("nums (sorted)", nums).pointers(#{ start: start, i: i }) ]);
            continue;
        }

        cur.push(nums[i]);
        step("rec", `Take ${nums[i]} and recurse from ${i + 1}.`,
            [ array("nums (sorted)", nums).ptr("i", i).hl([i]),
              array("current", cur).hl([cur.len() - 1]) ], "call");
        found = back(nums, i + 1, cur, found);
        cur.truncate(cur.len() - 1);
    }

    leave("");
    found
}

fn trace(input) {
    let nums = input.nums;
    let n = nums.len();
    for i in 1..n {
        let j = i;
        while j > 0 && nums[j - 1] > nums[j] {
            swap_at(nums, j - 1, j);
            j -= 1;
        }
    }

    enter("subsetsWithDup", #{ nums: A(nums) });
    step("sort", `Sort first: ${brackets(nums)}. Equal values must be adjacent for the skip rule to work.`,
        [ array("nums (sorted)", nums) ]);
    step("init", "Collect the subsets.", [ array("nums (sorted)", nums) ]);
    step("call", "Start from index 0 with an empty subset.",
        [ array("nums (sorted)", nums) ], "call");

    let found = back(nums, 0, [], []);

    let answer = `${found.len()}`;
    result(answer);
    step("ret", `${found.len()} distinct subset(s): ${join(found, ", ")}.`,
        [ text("subsets", found) ], "return");
    leave(answer);
}
